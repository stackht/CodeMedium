generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileChoice {
  YES
  NO
}

model ProfileQueueEvent {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  otpHash    String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?

  @@index([email, createdAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String   @unique
  passwordHash String
  phone        String
  year         String
  branch       String
  linkedinUrl  String?
  githubUrl    String?
  linkedinChoice ProfileChoice?
  githubChoice   ProfileChoice?
  profileQueueNumber Int? @unique
  queuedAt     DateTime?
  sScore       Int?
  pScore       Int?
  dScore       Int?
  reviewStatus String   @default("PENDING")
  interviewDone Boolean @default(false)
  createdAt    DateTime @default(now())
  challenges   UserChallenge[]
  uploads      ChallengeUpload[]
  queueEvents  ProfileQueueEvent[]
}

model OtpToken {
  id         String   @id @default(cuid())
  name       String
  email      String
  otpHash    String
  phone      String
  year       String
  branch     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?

  @@index([email, createdAt])
}

model UserChallenge {
  id         String   @id @default(cuid())
  userId     String
  statementId Int
  statement String
  createdAt  DateTime @default(now())
  releasedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  uploads ChallengeUpload[]

  @@index([userId, createdAt])
}

model ChallengeUpload {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id])
  challenge UserChallenge @relation(fields: [challengeId], references: [id])

  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  content   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}



